<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 备份/设备转移规则：同上排除含凭据的 SharedPreferences -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
